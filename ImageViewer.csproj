<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType><TargetFramework>net10.0-windows</TargetFramework><UseWPF>true</UseWPF><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <AssemblyName>ImageViewer</AssemblyName><Version>1.2.1</Version><RootNamespace>ImageViewer</RootNamespace><ApplicationManifest>app.manifest</ApplicationManifest><ApplicationIcon>Assets\ImageViewer.ico</ApplicationIcon>
    <PublishSingleFile>true</PublishSingleFile><SelfContained>true</SelfContained><RuntimeIdentifier>win-x64</RuntimeIdentifier><IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract><EnableCompressionInSingleFile>true</EnableCompressionInSingleFile><DebugType>none</DebugType><DebugSymbols>false</DebugSymbols>
  </PropertyGroup>
  <ItemGroup><PackageReference Include="SkiaSharp" Version="4.151.1" /></ItemGroup>
  <ItemGroup><Resource Include="Assets\ImageViewer.ico" /><None Update="Assets\ImageViewer.png" CopyToOutputDirectory="Never" /></ItemGroup>
  <Target Name="RemoveNativeDebugSymbols" AfterTargets="Publish"><Delete Files="$(PublishDir)libSkiaSharp.pdb" /></Target>
</Project>
