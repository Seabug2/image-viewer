<UserControl x:Class="ImageViewer.ImagePane" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 AllowDrop="True" Drop="OnDrop" DragEnter="OnDragEnter" DragOver="OnDragEnter" DragLeave="OnDragLeave" MouseMove="Pane_MouseMove" MouseLeave="Pane_MouseLeave" SizeChanged="Pane_SizeChanged" Background="#17191D">
 <Border BorderBrush="#30343C" BorderThickness="1" Margin="2" ClipToBounds="True"><Grid>
  <Image x:Name="Picture" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
  <StackPanel x:Name="EmptyPanel" VerticalAlignment="Center" HorizontalAlignment="Center"><TextBlock Text="이미지 · 폴더 · ZIP/CBZ를 여기에 놓으세요" Foreground="#AEB4C0" FontSize="16" Margin="12,12,12,4"/><TextBlock x:Name="EmptyStatus" Text="지원되는 이미지를 찾지 못했습니다" Foreground="#E2A45F" FontSize="14" Margin="12,0,12,12" HorizontalAlignment="Center" Visibility="Collapsed"/><Button Content="이미지 열기" Click="Open_Click" HorizontalAlignment="Center"/></StackPanel>
  <Border x:Name="DropHint" Background="#AA3976D3" Visibility="Collapsed"><TextBlock Text="여기에 놓아 열기" Foreground="White" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
  <Button x:Name="ClearButton" Content="×" Width="28" Height="28" Padding="0" Margin="8" HorizontalAlignment="Right" VerticalAlignment="Top" Panel.ZIndex="8" FontSize="18" FontWeight="SemiBold" Foreground="White" Background="#B34B3035" BorderBrush="#C7777D" Visibility="Collapsed" Opacity="0" IsHitTestVisible="False" Click="Clear_Click" ToolTip="이 영역 불러오기 종료"/>
  <Border x:Name="BottomBar" VerticalAlignment="Bottom" HorizontalAlignment="Stretch" MaxWidth="620" Margin="6" Padding="8" CornerRadius="12" Background="#E622252B" Opacity="0"><Grid>
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid Grid.Row="0" Margin="0,0,0,6">
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*" MinWidth="18"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <Button Grid.Column="0" Content="‹" Click="Previous_Click" PreviewMouseRightButtonUp="PreviousSource_RightClick" Padding="10,5" ToolTip="클릭: 이전 이미지&#x0a;우클릭: 이전 폴더/압축파일"/>
    <Slider Grid.Column="1" x:Name="PositionSlider" Minimum="1" Maximum="1" Value="1" TickFrequency="1" IsSnapToTickEnabled="True" Margin="6,0" ValueChanged="Position_Changed" ToolTip="현재 이미지 위치"/>
    <TextBlock Grid.Column="2" x:Name="PositionText" Text="0 / 0" Foreground="White" MinWidth="60" TextAlignment="Center" VerticalAlignment="Center" Margin="0,0,6,0"/>
    <Button Grid.Column="3" Content="›" Click="Next_Click" PreviewMouseRightButtonUp="NextSource_RightClick" Padding="10,5" ToolTip="클릭: 다음 이미지&#x0a;우클릭: 다음 폴더/압축파일"/>
   </Grid>
   <Grid Grid.Row="1">
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*" MinWidth="18"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <ToggleButton Grid.Column="0" x:Name="ShuffleToggle" Content="무작위" Foreground="White" Background="#333740" BorderBrush="#555B67" Padding="10,6" Margin="0,0,4,0" Checked="Shuffle_Changed" Unchecked="Shuffle_Changed" PreviewMouseRightButtonUp="Shuffle_RightClick" ToolTip="클릭: 이 영역만 변경&#x0a;우클릭: 모든 영역 동기화"/>
    <TextBlock Grid.Column="1" x:Name="IntervalMinLabel" Text="0" Foreground="#9CA3AF" Margin="2,0" VerticalAlignment="Center"/>
    <Slider Grid.Column="2" x:Name="IntervalSlider" Minimum="0" Maximum="60" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="Interval_Changed" PreviewMouseRightButtonDown="Slider_RightButtonDown" PreviewMouseMove="Slider_RightMouseMove" PreviewMouseRightButtonUp="Slider_RightButtonUp" ToolTip="왼쪽 드래그: 이 영역만 조절&#x0a;오른쪽 드래그: 모든 영역 동기화"/>
    <TextBlock Grid.Column="3" x:Name="IntervalMaxLabel" Text="60" Foreground="#9CA3AF" Margin="2,0" VerticalAlignment="Center"/>
    <TextBox Grid.Column="4" x:Name="SecondsBox" Text="0" Width="38" Margin="4,0,0,0" Foreground="White" Background="#333740" BorderBrush="#555B67" TextAlignment="Center" VerticalContentAlignment="Center" PreviewTextInput="Seconds_PreviewTextInput" LostFocus="Seconds_LostFocus" KeyDown="Seconds_KeyDown"/>
    <StackPanel Grid.Column="5" Margin="2,0"><Button Content="▴" Padding="4,0" Height="16" Click="Increase_Click" PreviewMouseRightButtonUp="Increase_RightClick" ToolTip="우클릭: 모든 영역을 이 값으로 동기화"/><Button Content="▾" Padding="4,0" Height="16" Click="Decrease_Click" PreviewMouseRightButtonUp="Decrease_RightClick" ToolTip="우클릭: 모든 영역을 이 값으로 동기화"/></StackPanel>
    <TextBlock Grid.Column="6" x:Name="SecondsUnit" Text="초" Foreground="White" VerticalAlignment="Center"/>
   </Grid>
  </Grid></Border>
  <Border x:Name="Caption" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="12" Padding="8,4" CornerRadius="7" Background="#AA111318" Visibility="Collapsed" Opacity="0"><TextBlock x:Name="CaptionText" Foreground="#E8EAF0" TextTrimming="CharacterEllipsis" MaxWidth="500"/></Border>
 </Grid></Border>
</UserControl>
